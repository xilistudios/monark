# Monark Default Google Drive Provider Credentials
#
# Copy this file to `.env` and fill in your Google OAuth credentials.
# The .env file is gitignored and will NOT be committed.
#
# These values are baked into the binary at compile time via build.rs
# and are NOT needed at runtime.
#
# Get these from: Google Cloud Console > APIs & Services > Credentials

MONARK_GOOGLE_DRIVE_CLIENT_ID=your-client-id-here
MONARK_GOOGLE_DRIVE_CLIENT_SECRET=your-client-secret-here
MONARK_GOOGLE_DRIVE_REDIRECT_URI=https://monark-password-manager.web.app
